# ============================================================================
# thekanjo.com — environment
#
# EVERY VARIABLE HERE IS OPTIONAL. The site runs with none of them: the content
# source defaults to the local files in content/, the media store to
# public/media/, and every external block renders a real destination without
# credentials. A fresh clone renders the whole site with no configuration.
#
# THIS FILE IS COMMITTED TO A PUBLIC REPOSITORY. It contains names and example
# shapes only — never a real value. Copy it to .env.local (which is gitignored)
# and fill that in.
#
# NOTHING SERVER-SIDE IS PREFIXED `NEXT_PUBLIC_`. That prefix inlines a value
# into the JavaScript bundle the browser downloads, which for a credential means
# publishing it. The two variables below that DO carry the prefix are the
# Supabase browser keys, which are designed to be public and are bounded by Row
# Level Security.
# ============================================================================


# ── Content and media backends ──────────────────────────────────────────────

# Where the site reads its configuration, AND where the admin writes it.
#   local     (default) — read and write content/*.json
#   supabase           — read and write one row in public.thekanjo_site
# One setting governs both directions on purpose: an admin writing local files
# while the site reads Supabase would be an editor whose saves change nothing.
# CONTENT_SOURCE=local

# Where admin uploads go.
#   local (default) — public/media/<folder>/
#   r2              — the Cloudflare R2 bucket below
# MEDIA_STORE=local


# ── Site identity ───────────────────────────────────────────────────────────

# The site's own origin, no trailing slash. Used for canonical URLs, absolute
# OpenGraph images, robots.txt and sitemap.xml.
# Falls back to `primaryDomain` in the content document.
# NEXT_PUBLIC_SITE_URL=https://thekanjo.com

# Force noindex. Not normally needed: every non-production deployment is
# noindexed automatically (lib/runtime/mode.ts reads VERCEL_ENV). Set it for a
# production build served from a staging domain.
# NEXT_PUBLIC_NOINDEX=true


# ============================================================================
# SUPABASE
#
# The Kanjo's table lives in the EXISTING Daineku Supabase project, prefixed
# `thekanjo_`. No Daineku table is read or written. See docs/PRODUCTION_SETUP.md.
# ============================================================================

# Server-side. SUPABASE_SECRET_KEY is the service-role credential: it BYPASSES
# Row Level Security, which is exactly why it must never reach a browser. The
# modules that read it import `server-only`, so a client component that tried
# would fail the BUILD rather than shipping the key.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=

# Browser-side, for admin sign-in only. These two ARE meant to be public — the
# publishable key's power is bounded by RLS, and this project enables RLS with
# no permissive policy, so the key grants no access to site content at all.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ============================================================================
# ADMIN
# ============================================================================

# Who may administer the site. Comma-separated, case-insensitive.
# AN EMPTY OR ABSENT LIST AUTHORISES NOBODY — a forgotten variable must not
# become an open admin. Checked server-side on every mutation.
# THEKANJO_ADMIN_EMAILS=someone@example.com,someone-else@example.com

# The LOCAL file-backed admin: development only, no accounts, writes
# content/*.json. The production half of the gate is not overridable — the route
# reads VERCEL_ENV, which Vercel sets itself.
# ADMIN_ENABLED=true

# Preview deployments read production content but CANNOT write it, so a pull
# request cannot edit the live site. Set this on one specific preview only if
# you genuinely intend otherwise.
# ADMIN_WRITE_ENABLED=true


# ============================================================================
# CLOUDFLARE R2 — media storage
#
# A SEPARATE bucket in the existing Cloudflare account. Create an API token
# scoped to this bucket alone, with Object Read & Write.
# ============================================================================

# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=thekanjo-media

# The PUBLIC hostname the bucket is served on — an r2.dev domain or a custom
# one. Separate from the credentials above because uploading does not make an
# object readable; the bucket has to be published. It becomes the `src` of every
# uploaded image, so it must be https and must be reachable by a browser.
# R2_PUBLIC_BASE_URL=https://media.thekanjo.com


# ============================================================================
# PATREON — the homepage development log
#
# Optional. Without a token the block renders its copy and a VIEW ON PATREON
# button pointing at the configured creator page — the normal state of a fresh
# clone, and not an error. See docs/PATREON.md.
# ============================================================================

# The campaign owner's OAuth access token, from
# https://www.patreon.com/portal/registration/register-clients
# REQUIRED SCOPE: campaigns.posts (read access to the campaign's posts).
# API v1 is deprecated and is not used anywhere in this project.
# PATREON_ACCESS_TOKEN=

# Optional. The campaign to read posts from. With one campaign on the account it
# is discovered automatically; setting it saves a request per revalidation.
# Do not guess a value — leave it unset rather than inventing one.
# PATREON_CAMPAIGN_ID=

# How long a fetched feed is reused. Default 3600 (one hour); below 60 ignored.
# PATREON_REVALIDATE_SECONDS=3600


# ============================================================================
# YOUTUBE — the homepage's latest video
#
# Optional. Without a key the block renders WATCH ON YOUTUBE pointing at the
# configured channel. Nothing fake is ever shown. See docs/PRODUCTION_SETUP.md.
#
# The latest upload is resolved as:
#   @thekanjo -> channels.list(forHandle) -> uploads playlist ->
#   playlistItems.list -> newest public item
# ============================================================================

# A Google Cloud API key with the YouTube Data API v3 enabled. Server-side only:
# it is a quota, and a key in the browser bundle is a quota anyone can spend.
# Restrict it to the YouTube Data API v3 in the Google Cloud console.
# YOUTUBE_API_KEY=

# How long a resolved video is reused. Default 900 (15 minutes); below 60
# ignored. Each refresh costs 2 quota units of a 10,000/day default.
# YOUTUBE_REVALIDATE_SECONDS=900


# ============================================================================
# TIKTOK
#
# NO CREDENTIALS ARE NEEDED. The homepage uses TikTok's official Creator Profile
# Embed for a public profile, which requires no developer app, no Login Kit
# review and no video.list authorisation. The profile URL is CONTENT, not
# configuration — it is edited in the admin. See docs/TIKTOK.md.
# ============================================================================
