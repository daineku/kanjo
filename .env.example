# ============================================================================
# thekanjo.com — environment
#
# EVERY VARIABLE HERE IS OPTIONAL. The site runs with none of them: the content
# source defaults to the local files in content/, so a fresh clone renders the
# whole site with no configuration. Copy this to .env.local only if you need one.
# ============================================================================

# Which content source to read.
#   local  (default) — read content/
#   remote           — a hosted backend. NOT IMPLEMENTED; the seam lives at
#                      lib/content/remote/index.ts and fails with an actionable
#                      message. See docs/BACKEND_DECISION.md for why the backend
#                      is separate from Daineku's.
# CONTENT_SOURCE=local

# The site's own origin, no trailing slash. Used for canonical URLs, absolute
# OpenGraph images, robots.txt and sitemap.xml.
# Falls back to `primaryDomain` in content/site.json.
# Set this on a preview deployment so it describes itself rather than production.
# NEXT_PUBLIC_SITE_URL=https://thekanjo.com

# Set to `true` on any deployment that is not production. robots.txt disallows
# everything and every page gets noindex/nofollow, so a preview cannot compete
# with production in a search index.
# NEXT_PUBLIC_NOINDEX=true

# ── Only needed once CONTENT_SOURCE=remote is implemented ──────────────────
# CONTENT_API_URL=
# CONTENT_API_KEY=
