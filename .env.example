# ============================================================================
# thekanjo.com — environment
#
# EVERY VARIABLE HERE IS OPTIONAL. The site runs with none of them: the content
# source defaults to the local files in content/, so a fresh clone renders the
# whole site with no configuration. Copy this to .env.local only if you need one.
# ============================================================================

# Which content source to read.
#   local  (default) — read content/
#   remote           — a hosted backend. NOT IMPLEMENTED; the seam lives at
#                      lib/content/remote/index.ts and fails with an actionable
#                      message. See docs/BACKEND_DECISION.md for why the backend
#                      is separate from Daineku's.
# CONTENT_SOURCE=local

# The site's own origin, no trailing slash. Used for canonical URLs, absolute
# OpenGraph images, robots.txt and sitemap.xml.
# Falls back to `primaryDomain` in content/site.json.
# Set this on a preview deployment so it describes itself rather than production.
# NEXT_PUBLIC_SITE_URL=https://thekanjo.com

# Set to `true` on any deployment that is not production. robots.txt disallows
# everything and every page gets noindex/nofollow, so a preview cannot compete
# with production in a search index.
# NEXT_PUBLIC_NOINDEX=true

# ── Only needed once CONTENT_SOURCE=remote is implemented ──────────────────
# CONTENT_API_URL=
# CONTENT_API_KEY=

# ============================================================================
# ADMIN
#
# The content admin at /admin. It has NO AUTHENTICATION and it writes files in
# content/, so it is a DEVELOPMENT TOOL: the route 404s in production whatever
# this is set to, and the Server Actions behind it refuse to run. Setting it to
# anything but `true` leaves the route absent.
# ============================================================================
# ADMIN_ENABLED=true

# ============================================================================
# PATREON — the homepage's development log
#
# EVERY VARIABLE HERE IS OPTIONAL, and the site is complete without them: with
# no token the Patreon section renders its configured copy and a VIEW ON PATREON
# button, which is the normal state of a fresh clone. See docs/PATREON.md.
#
# NONE OF THESE MAY BE PREFIXED NEXT_PUBLIC_. That prefix inlines a value into
# the JavaScript bundle the browser downloads, which for a credential means
# publishing it. The modules that read these import `server-only`, so a client
# component that tried to reach them would fail the BUILD rather than shipping
# the token.
# ============================================================================

# The campaign owner's OAuth access token, from a Patreon API client at
# https://www.patreon.com/portal/registration/register-clients.
# REQUIRED SCOPE: campaigns.posts (read access to the campaign's posts).
# API v1 is deprecated and is not used anywhere in this project.
# PATREON_ACCESS_TOKEN=

# Optional. The campaign to read posts from. With one campaign on the account it
# is discovered automatically; setting it saves a request per revalidation and
# removes any ambiguity for an account with two.
# PATREON_CAMPAIGN_ID=

# Optional. How long a fetched feed is reused before Patreon is asked again.
# Defaults to 3600 (one hour); values below 60 are ignored. Devlog posts appear
# a few times a month, so a short window is requests spent on nothing.
# PATREON_REVALIDATE_SECONDS=3600
