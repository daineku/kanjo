{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "maxLength": 140,
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "sku": {
      "type": "string",
      "maxLength": 64,
      "regex": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "required": true
    },
    "brand": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::brand.brand",
      "inversedBy": "products"
    },
    "manufacturer": {
      "type": "string",
      "maxLength": 120
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "products"
    },
    "productType": {
      "type": "enumeration",
      "enum": [
        "part",
        "accessory",
        "custom_3d_print",
        "merchandise"
      ],
      "default": "part",
      "required": true
    },
    "authenticity": {
      "type": "enumeration",
      "enum": [
        "genuine_oem",
        "genuine_aftermarket",
        "third_party_replacement",
        "replica_reproduction",
        "custom_made",
        "unverified"
      ],
      "default": "unverified",
      "required": true
    },
    "condition": {
      "type": "enumeration",
      "enum": [
        "new",
        "new_old_stock",
        "used_excellent",
        "used_good",
        "used_fair",
        "refurbished"
      ],
      "default": "new",
      "required": true
    },
    "shortDescription": {
      "type": "text",
      "maxLength": 300
    },
    "description": {
      "type": "richtext"
    },
    "specifications": {
      "type": "component",
      "component": "catalog.spec",
      "repeatable": true
    },
    "tags": {
      "type": "string",
      "maxLength": 300
    },
    "price": {
      "type": "decimal",
      "min": 0
    },
    "currency": {
      "type": "enumeration",
      "enum": [
        "USD",
        "EUR",
        "GBP",
        "THB",
        "CAD"
      ],
      "default": "USD",
      "required": true
    },
    "discountPrice": {
      "type": "decimal",
      "min": 0
    },
    "costPrice": {
      "type": "decimal",
      "min": 0,
      "private": true
    },
    "availability": {
      "type": "enumeration",
      "enum": [
        "in_stock",
        "made_to_order",
        "source_on_demand",
        "out_of_stock",
        "coming_soon",
        "discontinued"
      ],
      "default": "out_of_stock",
      "required": true
    },
    "countryOfOrigin": {
      "type": "string",
      "maxLength": 2
    },
    "supplier": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::supplier.supplier",
      "inversedBy": "products",
      "private": true
    },
    "supplierReference": {
      "type": "string",
      "private": true
    },
    "sourceUrl": {
      "type": "string",
      "maxLength": 600,
      "private": true
    },
    "sourcePrice": {
      "type": "decimal",
      "min": 0,
      "private": true
    },
    "sourceCurrency": {
      "type": "enumeration",
      "enum": [
        "USD",
        "EUR",
        "GBP",
        "THB",
        "CAD"
      ],
      "private": true
    },
    "supplierAvailability": {
      "type": "enumeration",
      "enum": [
        "unknown",
        "available",
        "limited",
        "unavailable"
      ],
      "default": "unknown",
      "private": true
    },
    "lastVerifiedAt": {
      "type": "datetime",
      "private": true
    },
    "importStatus": {
      "type": "enumeration",
      "enum": [
        "manual",
        "imported_unreviewed",
        "imported_reviewed"
      ],
      "default": "manual",
      "private": true
    },
    "marginPercent": {
      "type": "decimal",
      "private": true
    },
    "provenance": {
      "type": "text",
      "private": true
    },
    "weightGrams": {
      "type": "integer",
      "min": 0
    },
    "lengthMm": {
      "type": "integer",
      "min": 0
    },
    "widthMm": {
      "type": "integer",
      "min": 0
    },
    "heightMm": {
      "type": "integer",
      "min": 0
    },
    "shippingClass": {
      "type": "enumeration",
      "enum": [
        "standard",
        "bulky",
        "oversized",
        "fragile",
        "restricted"
      ],
      "default": "standard"
    },
    "hsCode": {
      "type": "string",
      "maxLength": 16
    },
    "handlingDays": {
      "type": "integer",
      "min": 0,
      "max": 365
    },
    "madeToOrder": {
      "type": "boolean",
      "default": false
    },
    "internationalShipping": {
      "type": "boolean",
      "default": true
    },
    "restrictedCountries": {
      "type": "string",
      "maxLength": 300
    },
    "mainImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "video": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "imageRights": {
      "type": "enumeration",
      "enum": [
        "own_photography",
        "supplier_licensed",
        "manufacturer_press",
        "not_cleared"
      ],
      "default": "not_cleared"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "variants": {
      "type": "component",
      "component": "catalog.variant",
      "repeatable": true
    },
    "universalFit": {
      "type": "boolean",
      "default": false
    },
    "fitments": {
      "type": "component",
      "component": "catalog.fitment",
      "repeatable": true
    },
    "reviewStatus": {
      "type": "enumeration",
      "enum": [
        "draft",
        "ready_for_review",
        "approved",
        "archived"
      ],
      "default": "draft",
      "required": true
    },
    "isSample": {
      "type": "boolean",
      "default": false
    },
    "unitsSold": {
      "type": "integer",
      "default": 0,
      "private": true
    },
    "previousSlugs": {
      "type": "text",
      "private": true
    }
  }
}
