    },
    "quantity": {
      "type": "integer",
      "required": true
    },
    "onHandAfter": {
      "type": "integer"
    },
    "reservedAfter": {
      "type": "integer"
    },
    "channel": {
      "type": "enumeration",
      "enum": [
        "web",
        "tiktok_shop",
        "manual",
        "system"
      ],
      "default": "system"
    },
    "orderReference": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "note": {
      "type": "text"
    }
  }
