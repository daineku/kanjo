# ============================================================================
# The Kanjo Parts CMS (Strapi 5) — environment
#
# NAMES AND SHAPES ONLY. Never commit a real value. Copy to .env (gitignored).
# Every secret below is server-side; the CMS has no browser-facing API.
# See docs/store/DEPLOYMENT.md.
# ============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337
# The CMS's public origin, e.g. https://cms.thekanjo.com (absolute media URLs).
PUBLIC_URL=
# true behind a reverse proxy / platform load balancer.
IS_PROXIED=false
CRON_ENABLED=true

# ── Strapi secrets: generate each with `openssl rand -base64 32` ────────────
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ── Database ────────────────────────────────────────────────────────────────
# Local development: sqlite (the default, .tmp/data.db).
# Production: postgres. With Supabase, use the DIRECT connection or the
# SESSION-mode pooler (port 5432) — NOT the transaction pooler (6543), which
# drops the search_path Strapi needs for a custom schema.
DATABASE_CLIENT=sqlite
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# DATABASE_SCHEMA=kanjo_store
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MIN=0

# ── Storefront link ─────────────────────────────────────────────────────────
# Shared with the website as STORE_CMS_TOKEN. At least 32 characters.
STOREFRONT_API_TOKEN=
# The website's origin. Checkout return URLs must start with it.
STOREFRONT_ORIGIN=https://thekanjo.com
# Where the CMS tells the website to refresh its catalogue cache.
STOREFRONT_REVALIDATE_URL=https://thekanjo.com/api/store/revalidate
# Shared with the website as STORE_REVALIDATE_SECRET.
STOREFRONT_REVALIDATE_SECRET=

# Serve explicitly-marked SAMPLE products (development only). Never in production.
KANJO_ALLOW_SAMPLE_CATALOG=false

# ── Payments ────────────────────────────────────────────────────────────────
# Leave both Stripe keys empty and the store is a browse-only catalogue.
# The keys belong to the Thai operating partner's Stripe account; they are
# entered by the partner directly in the host's secret settings.
# STRIPE_SECRET_KEY=sk_live_...   (or a restricted key rk_live_...)
# STRIPE_WEBHOOK_SECRET=whsec_...
# A sk_test_ key is refused on NODE_ENV=production unless this is true
# (staging only):
# KANJO_ALLOW_TEST_PAYMENTS=false
# Development / automated tests only; refused in production:
# PAYMENT_PROVIDER=mock

# ── Media: Cloudflare R2 (optional; local disk when unset) ──────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=thekanjo-store-media
# R2_PUBLIC_BASE_URL=https://store-media.thekanjo.com

# ── TikTok Shop (optional; the integration is inert without these) ──────────
# From the app created in TikTok Shop Partner Center (partner.tiktokshop.com).
# TIKTOK_SHOP_APP_KEY=
# TIKTOK_SHOP_APP_SECRET=
# TIKTOK_SHOP_SERVICE_ID=
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts stored tokens.
# TIKTOK_TOKEN_ENCRYPTION_KEY=
# JSON: our carrier → TikTok shipping provider id, from the seller's own
# "Get Shipping Providers" call, e.g. {"thailand_post":"...","dhl":"..."}
# TIKTOK_SHIPPING_PROVIDER_MAP=
